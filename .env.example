# Токен бота, выданный @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API (console.anthropic.com) для генерации ответов
ANTHROPIC_API_KEY=

# Модель Claude для ответов бота
CLAUDE_MODEL=claude-sonnet-5

# Поддомен вашего аккаунта GetCourse, например "yogamethodcourse"
GETCOURSE_ACCOUNT=

# Секретный ключ API из личного кабинета GetCourse
# (Настройки аккаунта -> Интеграции -> Секретный ключ для API)
GETCOURSE_API_KEY=
